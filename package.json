{
  "name": "vetman-briefing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "해외 수의사 커뮤니티(레딧) 주간 다이제스트 파이프라인",
  "scripts": {
    "collect": "node --env-file-if-exists=.env src/run.js --collect-only",
    "run": "node --env-file-if-exists=.env src/run.js",
    "publish:today": "node --env-file-if-exists=.env src/run.js --publish",
    "build": "node src/build.js",
    "prebuild": "node scripts/generate-editorial-cards.js && node scripts/generate-icons.js",
    "media:cards": "node scripts/generate-editorial-cards.js",
    "normalize:sources": "node scripts/resolve-source-urls.js",
    "source:resolve": "node scripts/resolve-source-candidates.js",
    "source:review": "node scripts/source-review.js",
    "review:stats": "node scripts/review-cli.js stats",
    "review:next": "node scripts/review-cli.js next",
    "review:show": "node scripts/review-cli.js show",
    "review:approve": "node scripts/review-cli.js approve",
    "review:reject": "node scripts/review-cli.js reject",
    "review:request-vet": "node scripts/review-cli.js request-vet",
    "review:correct": "node scripts/review-cli.js correct",
    "review:export": "node scripts/review-cli.js export",
    "source:stats": "node scripts/source-registry.js stats",
    "source:next": "node scripts/source-registry.js next",
    "source:show": "node scripts/source-registry.js show",
    "source:approve": "node scripts/source-registry.js approve",
    "source:reject": "node scripts/source-registry.js reject",
    "source:registry:audit": "node scripts/source-registry.js registry:audit",
    "source:registry:generate": "node scripts/source-registry.js registry:generate",
    "seo:import:gsc": "node scripts/seo-performance.js import gsc",
    "seo:import:naver": "node scripts/seo-performance.js import naver",
    "seo:performance": "node scripts/seo-performance.js performance",
    "image:rights": "node scripts/image-rights-audit.js",
    "seo:audit": "node scripts/seo-audit.js",
    "test:browser": "playwright test",
    "lighthouse": "lhci autorun && node scripts/lighthouse-summary.js",
    "qa": "npm run test:browser && npm run lighthouse",
    "monitor:production": "node scripts/monitor-production.js",
    "dev": "wrangler pages dev site --port 8788",
    "check": "npm test && npm run build && npm run validate",
    "validate": "node src/validate.js",
    "repair-publication": "node src/repair-publication.js --apply",
    "quality-report": "node src/quality-report.js",
    "repair-images": "node src/repair-images.js",
    "check-assets": "node src/check-assets.js",
    "check-sources": "node src/check-sources.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "fast-xml-parser": "^5.10.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.0",
    "lighthouse": "^13.4.1",
    "sharp": "0.34.5",
    "wrangler": "^4.112.0"
  }
}
