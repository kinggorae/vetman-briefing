# Reddit script 앱 (reddit.com/prefs/apps 에서 발급)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# 형식 자유이나 고유하게: platform:app-id:version (by /u/유저명)
REDDIT_USER_AGENT=macos:vetman-briefing:v0.1 (by /u/YOUR_REDDIT_USERNAME)

# ── LLM 설정 ──
# 방법 1: Anthropic API (한국어 품질·웹 검색 지원)
LLM_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5

# 방법 2: MiniMax (Anthropic 호환 게이트웨이 — 웹 검색은 비활성화됨)
# 아래 3줄 주석을 풀고 MiniMax API 키를 넣으세요 (platform.minimax.io 에서 발급)
# LLM_BASE_URL=https://api.minimax.io/anthropic
# LLM_API_KEY=<MiniMax API 키>
# CLAUDE_MODEL=MiniMax-M2

# 선택적 검색 성과 API 자격증명(기본 운영은 CSV import; secret은 저장소에 넣지 않음)
GSC_SERVICE_ACCOUNT_JSON=
GSC_SITE_URL=https://news.vetmanlab.com/
NAVER_API_CLIENT_ID=
NAVER_API_CLIENT_SECRET=
